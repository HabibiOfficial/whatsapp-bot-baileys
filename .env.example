# Bot identity
BOT_NAME=WaBot
BOT_PREFIX=!

# Comma-separated WA numbers (no '+', country code first) that are allowed to run owner-only commands.
# Example: OWNER_NUMBERS=6281234567890,6289876543210
OWNER_NUMBERS=

# Storage
SESSION_DIR=./auth_info_baileys
DATA_DIR=./data

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info
